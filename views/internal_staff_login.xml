<odoo>
    <template id="internal_staff_login" name="Sotufab Internal Staff Login">
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>
        <t t-call="web.login_layout">
            <t t-set="disable_database_manager" t-value="True"/>
            <t t-set="disable_footer" t-value="True"/>
            <t t-set="login_card_classes" t-value="'sotufab-internal-login'"/>

            <div class="text-center mb-4">
                <h1 class="h5 mb-2">Sotufab — Portail Interne Staff &amp; Caisse</h1>
                <p class="text-muted mb-0">Accès réservé au personnel autorisé</p>
            </div>

            <form class="oe_login_form" role="form" action="/web/login" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3">
                    <label for="login" class="form-label">Adresse e-mail</label>
                    <input type="text"
                           name="login"
                           id="login"
                           t-att-value="login"
                           class="form-control"
                           required="required"
                           autocomplete="username"
                           autocapitalize="off"
                           autofocus="autofocus"/>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input type="password"
                           name="password"
                           id="password"
                           class="form-control"
                           required="required"
                           autocomplete="current-password"
                           maxlength="4096"/>
                </div>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>

                <input type="hidden" name="redirect" value="/web"/>
                <button type="submit" class="btn btn-primary w-100">Se connecter</button>
            </form>
        </t>
    </template>
</odoo>

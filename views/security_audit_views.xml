<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_verify_audit_integrity" model="ir.actions.server">
        <field name="name">Vérifier l'intégrité SHA-256</field>
        <field name="model_id" ref="model_cartes_reduction_security_audit"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="code"><![CDATA[
result = env['cartes.reduction.security.audit'].sudo().verify_integrity()
if result.get('valid'):
    message = 'Chaîne PostgreSQL et sceau externe valides (%s événements, séquence %s).' % (
result.get('entries', 0),
result.get('seal', {}).get('sequence', 0),
    )
    notification_type = 'success'
else:
    message = 'Intégrité compromise : événement %s, motif %s.' % (
        result.get('id', 'inconnu'),
        result.get('reason', 'inconnu'),
    )
    notification_type = 'danger'
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Vérification de la chaîne d’audit',
        'message': message,
        'type': notification_type,
        'sticky': True,
    },
}
        ]]></field>
    </record>

    <record id="action_initialize_external_seal" model="ir.actions.server">
        <field name="name">Initialiser le sceau externe</field>
        <field name="model_id" ref="model_cartes_reduction_security_audit"/>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <field name="code"><![CDATA[
action = env['cartes.reduction.security.audit'].sudo().action_initialize_external_seal()
        ]]></field>
    </record>

    <record id="view_security_audit_tree" model="ir.ui.view">
        <field name="name">cartes.reduction.security.audit.tree</field>
        <field name="model">cartes.reduction.security.audit</field>
        <field name="arch" type="xml">
            <tree string="Journal de sécurité SHA-256" create="0" edit="0" delete="0">
                <header>
                    <button name="%(action_verify_audit_integrity)d" type="action"
                            string="Vérifier l'intégrité SHA-256" class="btn-primary"
                            groups="base.group_system"/>
                    <button name="%(action_initialize_external_seal)d" type="action"
                            string="Initialiser le sceau externe" class="btn-secondary"
                            groups="base.group_system"/>
                </header>
                <field name="event_at" string="Horodatage"/>
                <field name="event_type" widget="badge"
                       decoration-success="event_type in ['redemption', 'pin_set', 'login', 'pos_session_opened']"
                       decoration-warning="event_type in ['cin_reveal', 'logout', 'pos_session_closed']"
                       decoration-danger="event_type in ['replay_blocked', 'double_spend_blocked', 'idor_blocked', 'injection_blocked', 'hmac_invalid', 'seal_verify', 'otp_expired', 'velocity_abuse', 'unauthorized_access', 'tampered_token', 'ml_integrity_failure', 'pos_otp_failed', 'pin_failed', 'login_failed']"/>
                <field name="event_id" string="ID événement" optional="hide"/>
                <field name="prev_hash" string="Empreinte précédente" width="180px" optional="show"/>
                <field name="entry_hash" string="Empreinte SHA-256" width="180px" optional="show"/>
                <field name="details" string="Utilisateur · rôle RBAC · adresse IP"
                       width="480px" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_security_audit_form" model="ir.ui.view">
        <field name="name">cartes.reduction.security.audit.form</field>
        <field name="model">cartes.reduction.security.audit</field>
        <field name="arch" type="xml">
            <form string="Événement de sécurité SHA-256" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="event_at"/>
                        <field name="event_type" widget="badge"/>
                        <field name="event_id" string="ID événement"/>
                    </group>
                    <group string="Chaîne d'intégrité cryptographique">
                        <field name="prev_hash" string="Empreinte précédente"/>
                        <field name="entry_hash" string="Empreinte SHA-256"/>
                    </group>
                    <group string="Détails">
                        <field name="details" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_audit" model="ir.actions.act_window">
        <field name="name">Journal de sécurité SHA-256</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
    </record>

    <record id="action_security_login_audit" model="ir.actions.act_window">
        <field name="name">Journal des Connexions</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
        <field name="domain">[('event_type', 'in', ['login', 'logout', 'login_failed', 'pos_session_opened', 'pos_session_closed'])]</field>
    </record>

    <record id="action_security_cashier_logins" model="ir.actions.act_window">
        <field name="name">Connexions Caissiers POS</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
        <field name="domain">[('event_type', 'in', ['login', 'logout', 'login_failed']), ('details', 'ilike', 'Rôle RBAC : Caissier POS restreint')]</field>
    </record>

    <record id="action_security_ecommerce_logins" model="ir.actions.act_window">
        <field name="name">Connexions Clients E-Commerce</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
        <field name="domain">[('event_type', 'in', ['login', 'logout', 'login_failed']), ('details', 'ilike', 'Rôle RBAC : Client Portail')]</field>
    </record>

    <record id="action_security_admin_logins" model="ir.actions.act_window">
        <field name="name">Connexions Administration</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
        <field name="domain">['&amp;', ('event_type', 'in', ['login', 'logout', 'login_failed']), '|', ('details', 'ilike', 'Rôle RBAC : Administrateur'), ('details', 'ilike', 'Rôle RBAC : Gestionnaire Cartes')]</field>
    </record>

    <record id="action_security_usage" model="ir.actions.act_window">
        <field name="name">Utilisation Cartes &amp; OTP</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
        <field name="domain">[('event_type', 'in', ['redemption', 'pin_set', 'pos_otp_failed', 'cin_reveal'])]</field>
    </record>

    <record id="action_security_incidents" model="ir.actions.act_window">
        <field name="name">Incidents &amp; Alertes SHA-256</field>
        <field name="res_model">cartes.reduction.security.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_security_audit_tree"/>
        <field name="domain">[('event_type', 'in', ['replay_blocked', 'double_spend_blocked', 'idor_blocked', 'injection_blocked', 'cin_reveal', 'hmac_invalid', 'seal_verify', 'otp_expired', 'velocity_abuse', 'unauthorized_access', 'tampered_token', 'ml_integrity_failure', 'pos_otp_failed', 'pin_failed', 'login_failed'])]</field>
    </record>
</odoo>

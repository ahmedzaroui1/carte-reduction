<odoo>
    <record id="view_security_audit_tree" model="ir.ui.view">
        <field name="name">cartes.reduction.security.audit.tree</field>
        <field name="model">cartes_reduction.security.audit</field>
        <field name="arch" type="xml">
            <tree string="Security Audit Logs" create="0" edit="0" delete="0"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'warning'">
                <field name="event_date"/>
                <field name="severity"/>
                <field name="event_type"/>
                <field name="channel"/>
                <field name="user_id"/>
                <field name="card_ref"/>
            </tree>
        </field>
    </record>

    <record id="view_security_audit_form" model="ir.ui.view">
        <field name="name">cartes.reduction.security.audit.form</field>
        <field name="model">cartes_reduction.security.audit</field>
        <field name="arch" type="xml">
            <form string="Security Audit Event" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="event_date"/>
                        <field name="severity"/>
                        <field name="event_type"/>
                        <field name="channel"/>
                        <field name="user_id"/>
                        <field name="card_ref"/>
                    </group>
                    <field name="details"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_security_audit_graph" model="ir.ui.view">
        <field name="name">cartes.reduction.security.audit.graph</field>
        <field name="model">cartes_reduction.security.audit</field>
        <field name="arch" type="xml">
            <graph string="Security Events" type="bar">
                <field name="event_type"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_security_audit_pivot" model="ir.ui.view">
        <field name="name">cartes.reduction.security.audit.pivot</field>
        <field name="model">cartes_reduction.security.audit</field>
        <field name="arch" type="xml">
            <pivot string="Security Audit Analysis">
                <field name="event_type" type="row"/>
                <field name="channel" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_security_audit" model="ir.actions.act_window">
        <field name="name">Sécurité &amp; Audit Logs</field>
        <field name="res_model">cartes_reduction.security.audit</field>
        <field name="view_mode">graph,pivot,tree,form</field>
    </record>
</odoo>

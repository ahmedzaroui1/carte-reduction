<odoo>
    <record id="security_audit_read_rule" model="ir.rule">
        <field name="name">Security audit: internal users can read</field>
        <field name="model_id" ref="model_cartes_reduction_security_audit"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('id', '&gt;', 0)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>

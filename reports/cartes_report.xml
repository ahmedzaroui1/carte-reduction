<odoo>
    <!-- Définition de l'action du rapport -->
    <record id="cartes_report_action" model="ir.actions.report">
        <field name="name">Rapport des Cartes</field>
        <field name="model">cartes.reduction</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_cartes_reduction"/>
        <field name="binding_type">report</field>
        <field name="report_name">cartes_reduction.property_report_template</field>

    </record>

    <!-- Modèle de rapport (template) -->
    <template id="property_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Rapport des Cartes</h2>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Type</th>
                                <th>Réduction</th>
                                <th>Utilisateurs</th>
                                <th>Maximum</th>
                                <th>État</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td><span t-field="o.name"/></td>
                                    <td><span t-field="o.carte_type"/></td>
                                    <td><span t-field="o.discount"/>%</td>
                                    <td><span t-field="o.nombre_utilisateurs"/></td>
                                    <td><span t-field="o.nombre_utilisateurs_max"/></td>
                                    <td><span t-field="o.state"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>

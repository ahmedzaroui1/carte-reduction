<odoo>
    <record id="rule_portal_partner_own" model="ir.rule">
        <field name="name">Portal user sees own partner only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_portal_attribution_own" model="ir.rule">
        <field name="name">Portal user sees own card attributions</field>
        <field name="model_id" ref="cartes_reduction.model_cartes_attribution"/>
        <field name="domain_force">[('client_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_portal_notifications_own" model="ir.rule">
        <field name="name">Portal user sees own notifications</field>
        <field name="model_id" ref="cartes_reduction.model_notifications_client"/>
        <field name="domain_force">[('client_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_partner_company_isolation" model="ir.rule">
        <field name="name">Partner multi-company isolation</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', '|', ('partner_share', '=', False), ('company_id', 'parent_of', user.company_ids.ids), ('company_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_sotufab_cashier_website_readonly" model="ir.rule">
        <field name="name">Sotufab cashier cannot change website records</field>
        <field name="model_id" ref="website.model_website"/>
        <field name="domain_force">[('id', '=', 0)] if user.login == 'caissier.sotufab' else [('id', '!=', 0)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sotufab_cashier_pos_config_readonly" model="ir.rule">
        <field name="name">Sotufab cashier cannot modify POS configuration</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="domain_force">[('id', '=', 0)] if user.login == 'caissier.sotufab' else [('id', '!=', 0)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>

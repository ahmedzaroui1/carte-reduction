<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_buttons.CustomAlertPopup" owl="2">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><t t-esc="props.title"/></h5>
            </div>
            <div class="modal-body">
                <t t-raw="props.body"/>
                <t t-if="props.otpMode">
                    <label class="form-label" for="pos-card-otp">Code OTP à 6 chiffres ou QR signé</label>
                    <input id="pos-card-otp" class="form-control" t-model="state.otp"
                           autocomplete="one-time-code"/>
                    <p class="mt-2 text-muted">Expiration dans <t t-esc="state.remaining"/> s.</p>
                </t>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" t-on-click="cancel">
                    <t t-esc="props.cancelText || 'Cancel'"/>
                </button>
                <button type="button" class="btn btn-primary" t-on-click="confirm"
                        t-att-disabled="props.otpMode &amp;&amp; !state.remaining">
                    <t t-esc="props.otpMode ? (props.confirmText || 'Vérifier') : (props.confirmText || 'Ok')"/>
                </button>
            </div>
        </div>
    </t>
</templates>
